{
  "name": "antibot-api",
  "version": "1.0.0",
  "description": "High-performance anti-bot detection API with VPN/proxy/Tor blocking and human validation",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node --test",
    "test:integration": "node --test tests/integration/**/*.test.js",
    "test:perf": "artillery run tests/performance/load-test.yml"
  },
  "keywords": [
    "antibot",
    "vpn-detection",
    "proxy-detection",
    "tor-detection",
    "bot-detection",
    "fraud-prevention"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@supabase/supabase-js": "^2.95.3",
    "axios": "^1.6.7",
    "bowser": "^2.11.0",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.2",
    "ip-cidr": "^4.0.1",
    "ipaddr.js": "^2.1.0",
    "lru-cache": "^10.2.0",
    "ua-parser-js": "^1.0.37"
  },
  "devDependencies": {
    "artillery": "^2.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
